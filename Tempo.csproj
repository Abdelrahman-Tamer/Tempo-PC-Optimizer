<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>Tempo</AssemblyName>
    <Product>Tempo PC Optimizer</Product>
    <Company>Eng. Abdelrahman Emam</Company>
    <Authors>Eng. Abdelrahman Emam</Authors>
    <Version>2.2.3</Version>
    <AssemblyVersion>2.2.3.0</AssemblyVersion>
    <FileVersion>2.2.3.0</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NoWarn>WFO0003;CS0104;CS0414</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <Target Name="RemoveNonWindowsRuntimes" AfterTargets="Publish">
    <ItemGroup>
      <_UnwantedPdb Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_UnwantedPdb)" />
    <Exec Command="powershell -NoProfile -Command &quot;if (Test-Path '$(PublishDir)runtimes') { Get-ChildItem '$(PublishDir)runtimes' -Directory | Where-Object { $_.Name -notmatch '^win' } | Remove-Item -Recurse -Force }&quot;" />
  </Target>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app.png" />
    <None Update="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

</Project>
