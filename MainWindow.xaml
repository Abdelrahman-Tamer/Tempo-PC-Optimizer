<Window x:Class="Tempo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tempo Diagnostic"
        Width="440" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        FontFamily="Segoe UI Variable Display, IBM Plex Sans, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- SLIM MODERN DARK SCROLLBAR (يثري الثيم الداكن ويلغي اللون الأبيض الافتراضي) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" Background="#2E3440" CornerRadius="3" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#0066FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="true">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#44DDC1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tempo Precision Calibrated Palette (Obsidian Slate & Linear Inspired) -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0E14"/>
        <SolidColorBrush x:Key="SurfaceLow" Color="#10141D"/>
        <SolidColorBrush x:Key="SurfaceContainer" Color="#151B26"/>
        <SolidColorBrush x:Key="SurfaceHigh" Color="#1C2433"/>
        <SolidColorBrush x:Key="SurfaceHighest" Color="#242D40"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#1E2638"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2C374E"/>

        <SolidColorBrush x:Key="PrimaryCobalt" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryCobaltHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#93C5FD"/>
        <SolidColorBrush x:Key="TealHealth" Color="#10B981"/>
        <SolidColorBrush x:Key="AmberWarn" Color="#F59E0B"/>
        <SolidColorBrush x:Key="RedAlert" Color="#EF4444"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <!-- Window Control Buttons (─, ✕) -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#272A31"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Rail Button Style -->
        <Style x:Key="NavRailButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222631"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UNIFIED STENCIL BUTTON STYLE (إسطمبة موحدة بمقاس مريح وتجاوب كامل) -->
        <Style x:Key="ActionBtnStencil" TargetType="Button">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#141924"/>
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="BorderBrush" Value="#222B3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WARNING ACTION BUTTON STENCIL (للأزرار ذات شروط الأمان والتأكيد) -->
        <Style x:Key="ActionBtnWarningStencil" TargetType="Button">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#1E1914"/>
            <Setter Property="Foreground" Value="#F59E0B"/>
            <Setter Property="BorderBrush" Value="#3D3020"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D97706"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F59E0B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Hero Button Style (Prominent with Refined Sapphire Gradient) -->
        <Style x:Key="PrimaryHeroBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="2" Opacity="0.32"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FULL-WIDTH TOOL TILE BUTTON (بلاطات أدوات كاملة العرض متناسقة) -->
        <Style x:Key="ToolTileBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#161922"/>
            <Setter Property="Foreground" Value="#E0E2EC"/>
            <Setter Property="BorderBrush" Value="#2D343F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222631"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0066FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== -->
        <!-- GLOBAL APP-THEMED CHECKBOX (No white boxes!)   -->
        <!-- ============================================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border x:Name="CheckBorder"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="4"
                                        Background="#121622"
                                        BorderBrush="#2A3348"
                                        BorderThickness="1.2"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
                                          Data="M3.5,8.5 L7,12 L13.5,4.5"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Margin="2.5"
                                          Visibility="Collapsed"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#171E2E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== -->
        <!-- SEGMENTED RADIO BUTTON STYLE (For Feedback)     -->
        <!-- ============================================== -->
        <Style x:Key="SegmentedRadioBtn" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="9.8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Height="34"
                                Background="#121620"
                                BorderBrush="#222738"
                                BorderThickness="1.2"
                                CornerRadius="7"
                                Padding="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#181F2E"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2D3A50"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#172554"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TOOLBAR INTERACTIVE POD STYLE -->
        <Style x:Key="ToolbarPodStyle" TargetType="Border">
            <Setter Property="Background" Value="#141924"/>
            <Setter Property="BorderBrush" Value="#1E2638"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C2433"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TOOLBAR TURBO BOOST ICON BUTTON (SLEEK PILL BUTTON) -->
        <Style x:Key="ToolbarBoostBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" BorderThickness="1" BorderBrush="#1E3A5F" Background="#0F1E36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TOOLBAR UPDATE BADGE BUTTON (CLEAN GREEN CIRCLE) -->
        <Style x:Key="ToolbarUpdateBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" BorderThickness="1" BorderBrush="#059669" Background="#10B981">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#065F46"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TOOLBAR ICON BUTTON (MINIMALIST SMOOTH PILL BUTTON) -->
        <Style x:Key="ToolbarIconBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E283A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2A3850"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#151D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Startup App Item Template (Shared for Security and Regular Groups) -->
        <DataTemplate x:Key="StartupAppItemTemplate">
            <Border Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,5" ToolTip="{Binding TooltipText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Real Extracted App Icon -->
                    <Border Grid.Column="0" Width="30" Height="30" Background="#11141C" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Grid>
                            <!-- Elegant Fallback Monogram Badge -->
                            <TextBlock Text="{Binding Monogram}" Foreground="{StaticResource PrimaryAccent}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FallbackIconVisibility}"/>
                            <!-- Real icon -->
                            <Image FlowDirection="LeftToRight" Source="{Binding IconSource}" Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasIconVisibility}"/>
                        </Grid>
                    </Border>

                    <!-- Column 1: Info (Row 1: Title & Shield, Row 2: Status, Impact Pill, Scope) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- Row 1: App Title & Security Shield -->
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Visibility="{Binding SecurityBadgeVisibility}" Background="#25FFB77D" BorderBrush="#FFB77D" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding SecurityTooltipText}">
                                <StackPanel Orientation="Horizontal">
                                    <Path FlowDirection="LeftToRight" Data="M12,1 L3,5 L3,11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 L21,5 L12,1 Z" Fill="{StaticResource AmberWarn}" Width="8" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                    <TextBlock Text="🛡️" FontSize="8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Row 2: Status Dot + Status Label + Impact Badge + Scope -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                            <!-- Real Dynamic Status Dot (Teal for Enabled, Gray for Disabled) -->
                            <Ellipse Width="5" Height="5" Fill="{Binding StatusDotBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusDotBrush}" FontSize="9" FontWeight="Medium" Margin="0,0,5,0" VerticalAlignment="Center"/>

                            <!-- Startup Impact Badge (Cleanly on Line 2 without pushing against button) -->
                            <Border Background="{Binding ImpactBadgeBg}" CornerRadius="3" Padding="4,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImpactLabel}" Foreground="{Binding ImpactBadgeFg}" FontSize="8.5" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock Text="•" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LocationFriendly}" Foreground="{StaticResource TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Column 2: Action Button -->
                    <Button Grid.Column="2" MinWidth="68" Height="26" Style="{StaticResource ActionBtnStencil}" Content="{Binding ActionText}" Click="BtnDisableStartupApp_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 1. MAIN DASHBOARD VIEW -->
        <Border x:Name="MainDashboardView"
                Background="{StaticResource BgDark}"
                BorderBrush="{StaticResource BorderMuted}"
                BorderThickness="1"
                CornerRadius="10"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER BAR (RTL: Logo & Title on Right, Window Controls on Left) -->
                <Border x:Name="DashboardHeader" Grid.Row="0" FlowDirection="LeftToRight" Background="{StaticResource SurfaceLow}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title & Logo (Right side in RTL) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6" Background="#1D2027" BorderBrush="#2D343F" BorderThickness="1" Margin="0,0,8,0">
                                <Image FlowDirection="LeftToRight" x:Name="ImgHeaderLogo" RenderOptions.BitmapScalingMode="HighQuality" Margin="2"/>
                            </Border>
                            <TextBlock Text="Tempo PC Optimizer" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        </StackPanel>

                        <!-- Window Controls (Left side in RTL) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Discord-Style Download / Update Button -->
                            <Button x:Name="BtnUpdateBadge" Style="{StaticResource WindowControlBtn}" Width="Auto" Height="26" Padding="6,2" Margin="0,0,6,0" Click="BtnUpdateBadge_Click" Visibility="Collapsed" ToolTip="{DynamicResource BtnTooltipUpdate}">
                                <Border Background="#10B981" CornerRadius="13" Padding="7,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path FlowDirection="LeftToRight" Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="TxtUpdateBadgeText" Text="{DynamicResource BtnUpdateBadgeText}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button x:Name="BtnQuickToolbar" Style="{StaticResource WindowControlBtn}" Click="BtnLaunchToolbar_Click" ToolTip="{DynamicResource BtnTooltipToolbar}">
                                <Path FlowDirection="LeftToRight" Data="M3,5 L21,5 L21,9 L3,9 Z M3,11 L21,11 L21,13 L3,13 Z" Fill="{StaticResource TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnMinimize" Style="{StaticResource WindowControlBtn}" Click="BtnMinimize_Click" ToolTip="{DynamicResource BtnTooltipMinimize}">
                                <Path FlowDirection="LeftToRight" Data="M0,0 L10,0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                            </Button>
                            <Button x:Name="BtnCloseApp" Style="{StaticResource WindowCloseBtn}" Click="BtnCloseApp_Click" ToolTip="{DynamicResource BtnTooltipClose}">
                                <Path FlowDirection="LeftToRight" Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BODY: Navigation Rail (Column 0) + Content Stage (Column 1) -->
                <Grid x:Name="MainContentGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- NAVIGATION RAIL (Column 0: Left in LTR, Right in RTL) -->
                    <Border x:Name="BorderNavRail" Grid.Column="0" Background="{StaticResource SurfaceLow}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,6,0,0">
                                <!-- Overview Tab (نظرة) -->
                                <Button x:Name="BtnNavOverview" Style="{StaticResource NavRailButton}" Click="TabNavOverview_Click" ToolTip="{DynamicResource NavTooltipOverview}">
                                    <Grid Width="56" Height="54">
                                        <Rectangle x:Name="IndOverview" Width="3" Height="24" Fill="{StaticResource PrimaryCobalt}" HorizontalAlignment="Right" RadiusX="1.5" RadiusY="1.5" Visibility="Visible"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path FlowDirection="LeftToRight" x:Name="IconNavOverview" Data="M12,4 A8,8 0 0,0 4,12 C4,14.2 4.9,16.2 6.3,17.7 L12,12 L17.7,17.7 C19.1,16.2 20,14.2 20,12 A8,8 0 0,0 12,4 Z M12,10 A2,2 0 1,1 12,14 A2,2 0 0,1 12,10 Z" Fill="{StaticResource PrimaryAccent}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtNavOverview" Text="{DynamicResource NavOverview}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccent}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Optimize Tab (تحسين) -->
                                <Button x:Name="BtnNavOptimize" Style="{StaticResource NavRailButton}" Click="TabNavOptimize_Click" ToolTip="{DynamicResource NavTooltipOptimize}">
                                    <Grid Width="56" Height="54">
                                        <Rectangle x:Name="IndOptimize" Width="3" Height="24" Fill="{StaticResource PrimaryCobalt}" HorizontalAlignment="Right" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path FlowDirection="LeftToRight" x:Name="IconNavOptimize" Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="{StaticResource TextSecondary}" Width="16" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtNavOptimize" Text="{DynamicResource NavOptimize}" FontSize="10" FontWeight="Normal" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Diagnostic Tab (فحص) -->
                                <Button x:Name="BtnNavDiagnostic" Style="{StaticResource NavRailButton}" Click="TabNavDiagnostic_Click" ToolTip="{DynamicResource NavTooltipDiagnostic}">
                                    <Grid Width="56" Height="54">
                                        <Rectangle x:Name="IndDiagnostic" Width="3" Height="24" Fill="{StaticResource PrimaryCobalt}" HorizontalAlignment="Right" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path FlowDirection="LeftToRight" x:Name="IconNavDiagnostic" Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M9,17 L7,17 L7,10 L9,10 L9,17 Z M13,17 L11,17 L11,7 L13,7 L13,17 Z M17,17 L15,17 L15,13 L17,13 L17,17 Z" Fill="{StaticResource TextSecondary}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtNavDiagnostic" Text="{DynamicResource NavDiagnostic}" FontSize="10" FontWeight="Normal" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Processes & RAM Tab (التطبيقات) -->
                                <Button x:Name="BtnNavProcesses" Style="{StaticResource NavRailButton}" Click="TabNavProcesses_Click" ToolTip="{DynamicResource NavTooltipProcesses}">
                                    <Grid Width="56" Height="54">
                                        <Rectangle x:Name="IndProcesses" Width="3" Height="24" Fill="{StaticResource PrimaryCobalt}" HorizontalAlignment="Right" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path FlowDirection="LeftToRight" x:Name="IconNavProcesses" Data="M3,5 C3,3.9 3.9,3 5,3 L19,3 C20.1,3 21,3.9 21,5 L21,19 C21,20.1 20.1,21 19,21 L5,21 C3.9,21 3,20.1 3,19 L3,5 Z M5,5 L5,8 L19,8 L19,5 L5,5 Z M5,10 L5,19 L19,19 L19,10 L5,10 Z M7,12 L11,12 L11,14 L7,14 L7,12 Z M13,12 L17,12 L17,14 L13,14 L13,12 Z" Fill="{StaticResource TextSecondary}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtNavProcesses" Text="{DynamicResource NavProcesses}" FontSize="10" FontWeight="Normal" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- Settings & Feedback Buttons pinned to bottom -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                <Button x:Name="BtnNavSettings" Style="{StaticResource NavRailButton}" Height="48" Click="TabNavSettings_Click" ToolTip="{DynamicResource NavTooltipSettings}">
                                    <Grid Width="56" Height="48">
                                        <Rectangle x:Name="IndSettings" Width="3" Height="22" Fill="{StaticResource PrimaryCobalt}" HorizontalAlignment="Right" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path FlowDirection="LeftToRight" x:Name="IconNavSettings" Data="M19.14,12.94 C19.17,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.17,11.37 19.14,11.06 L21.16,9.48 C21.34,9.34 21.39,9.08 21.28,8.88 L19.36,5.55 C19.25,5.35 19.01,5.27 18.8,5.35 L16.42,6.31 C15.93,5.93 15.39,5.62 14.81,5.39 L14.45,2.86 C14.41,2.63 14.21,2.46 13.97,2.46 L10.03,2.46 C9.79,2.46 9.59,2.63 9.55,2.86 L9.19,5.39 C8.61,5.62 8.07,5.93 7.58,6.31 L5.2,5.35 C4.99,5.27 4.75,5.35 4.64,5.55 L2.72,8.88 C2.61,9.08 2.66,9.34 2.84,9.48 L4.86,11.06 C4.83,11.37 4.8,11.68 4.8,12 C4.8,12.32 4.83,12.63 4.86,12.94 L2.84,14.52 C2.66,14.66 2.61,14.92 2.72,15.12 L4.64,18.45 C4.75,18.65 4.99,18.73 5.2,18.65 L7.58,17.69 C8.07,18.07 8.61,18.38 9.19,18.61 L9.55,21.14 C9.59,21.37 9.79,21.54 10.03,21.54 L13.97,21.54 C14.21,21.54 14.41,21.37 14.45,21.14 L14.81,18.61 C15.39,18.38 15.93,18.07 16.42,17.69 L18.8,18.65 C19.01,18.73 19.25,18.65 19.36,18.45 L21.28,15.12 C21.39,14.92 21.34,14.66 21.16,14.52 L19.14,12.94 Z M12,15.5 C10.07,15.5 8.5,13.93 8.5,12 C8.5,10.07 10.07,8.5 12,8.5 C13.93,8.5 15.5,10.07 15.5,12 C15.5,13.93 13.93,15.5 12,15.5 Z" Fill="{StaticResource TextSecondary}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtNavSettings" Text="{DynamicResource NavSettings}" FontSize="9.5" FontWeight="Normal" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button x:Name="BtnNavFeedback" Style="{StaticResource NavRailButton}" Height="48" Click="TabNavFeedback_Click" ToolTip="{DynamicResource NavTooltipFeedback}">
                                    <Grid Width="56" Height="48">
                                        <Rectangle x:Name="IndFeedback" Width="3" Height="22" Fill="{StaticResource PrimaryCobalt}" HorizontalAlignment="Right" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path FlowDirection="LeftToRight" x:Name="IconNavFeedback" Data="M20,2 H4 C2.9,2 2,2.9 2,4 V22 L6,18 H20 C21.1,18 22,17.1 22,16 V4 C22,2.9 21.1,2 20,2 Z M18,14 H6 V12 H18 V14 Z M18,10 H6 V8 H18 V10 Z" Fill="{StaticResource TextSecondary}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtNavFeedback" Text="{DynamicResource NavFeedback}" FontSize="9.5" FontWeight="Normal" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CONTENT STAGE (Column 0 in RTL = Main content area) -->
                    <ScrollViewer x:Name="MainContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,12">
                        <StackPanel>
                            <!-- ============================================== -->
                            <!-- TAB 1: OVERVIEW (نظرة عامة)                     -->
                            <!-- ============================================== -->
                            <StackPanel x:Name="PanelOverview" Visibility="Visible">
                                <!-- 1. Unified Health & Quick Boost Command Card (دمج حالة النظام مع زر التحسين) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Health Status & Score Badge -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="DotHealthGlow" Width="9" Height="9" Fill="{StaticResource TealHealth}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="TxtHealthStatus" Text="{DynamicResource TxtSystemStatusOptimal}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#1500382F" BorderBrush="#3044DDC1" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="LOAD " Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtHealthPercent" Text="--" Foreground="{StaticResource TealHealth}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: Target Junk & Diagnostics Summary -->
                                        <Grid Grid.Row="1" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource TxtObservedJunk}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                <TextBlock x:Name="TxtTargetFilesSize" Text="{DynamicResource TxtReadyForBoost}" Foreground="{StaticResource PrimaryAccent}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{DynamicResource TxtEstimatedTime}" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{DynamicResource TxtLessThanSecond}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontFamily="Consolas, monospace" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 2: Unified Hero Optimize Button (Prominent, Height 44, Blue Glow) -->
                                        <Button x:Name="BtnHeroOptimize" Grid.Row="2" Style="{StaticResource PrimaryHeroBtn}" Height="44" Click="BtnHeroOptimize_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path FlowDirection="LeftToRight" Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#FFFFFF" Width="14" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource BtnBoostNow}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 2. Unified Symmetrical Diagnostics: CPU & Memory (توحيد طريقة العرض) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- CPU Card (Progress Bar & Dynamic Status) -->
                                    <Border x:Name="CardCpuBorder" Grid.Column="0" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="{DynamicResource CardCpuTitle}" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"/>
                                                <Path FlowDirection="LeftToRight" Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M9,17 L7,17 L7,10 L9,10 L9,17 Z" Fill="{StaticResource TextMuted}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                                                <TextBlock x:Name="TxtCpuPercent" Text="--" Foreground="{StaticResource TealHealth}" FontSize="22" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                            </StackPanel>
                                            <ProgressBar x:Name="ProgCpuPercent" Height="5" Minimum="0" Maximum="100" Value="0" FlowDirection="LeftToRight" Background="#1C2433" Foreground="{StaticResource TealHealth}" BorderThickness="0" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="TxtCpuClockTemp" Text="--" Foreground="{StaticResource TextSecondary}" FontSize="10" FontFamily="Consolas, monospace" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Memory (RAM) Card (Progress Bar & Dynamic Status) -->
                                    <Border x:Name="CardRamBorder" Grid.Column="2" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="{DynamicResource CardRamTitle}" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"/>
                                                <Path FlowDirection="LeftToRight" Data="M4,4 L20,4 L20,20 L4,20 Z" Fill="{StaticResource TextMuted}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                                                <TextBlock x:Name="TxtRamPercentValue" Text="--" Foreground="{StaticResource TealHealth}" FontSize="22" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                            </StackPanel>
                                            <ProgressBar x:Name="ProgRamPercent" Height="5" Minimum="0" Maximum="100" Value="0" FlowDirection="LeftToRight" Background="#1C2433" Foreground="{StaticResource TealHealth}" BorderThickness="0" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="TxtRamUsageFormatted" Text="--" Foreground="{StaticResource TextSecondary}" FontSize="10" FontFamily="Consolas, monospace" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Storage Card (with RTL progress bar) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{DynamicResource CardStorageTitle}" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"/>
                                            <Path FlowDirection="LeftToRight" Data="M20,13 L4,13 C3.45,13 3,13.45 3,14 L3,18 C3,18.55 3.45,19 4,19 L20,19 C20.55,19 21,18.55 21,18 L21,14 C21,13.45 20.55,13 20,13 Z M6,17 C5.45,17 5,16.55 5,16 C5,15.45 5.45,15 6,15 C6.55,15 7,15.45 7,16 C7,16.55 6.55,17 6,17 Z" Fill="{StaticResource TextMuted}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,2,0,6">
                                            <TextBlock Text="{DynamicResource TxtFreeDiskSpace}" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="TxtStorageFree" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="11" FontFamily="Consolas, monospace" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="ProgStorageUsed" Height="5" Minimum="0" Maximum="100" Value="0" FlowDirection="LeftToRight" Background="#1C2433" Foreground="{StaticResource TealHealth}" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- System Recommendations Card (توصيات النظام) - STENCIL BUTTONS (إسطمبة موحدة) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <Border Padding="12,8" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <TextBlock Text="{DynamicResource TxtRecommendations}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <Border Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                    <TextBlock Text="3" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Item 1: Temp Files -->
                                        <Border Padding="12,8" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="28" Height="28" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                                                    <Path FlowDirection="LeftToRight" Data="M15,4 L20,4 L20,6 L19,6 L19,19 C19,20.1 18.1,21 17,21 L7,21 C5.9,21 5,20.1 5,19 L5,6 L4,6 L4,4 L9,4 L10,3 L14,3 L15,4 Z" Fill="{StaticResource TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource TxtTempTitleShort}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Medium"/>
                                                    <TextBlock Text="{DynamicResource TxtTempDescShort}" Foreground="{StaticResource TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" x:Name="TxtRecTempSize" Text="{DynamicResource TxtReady}" Foreground="{StaticResource PrimaryAccent}" FontSize="10" FontFamily="Consolas, monospace" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Column="3" Style="{StaticResource ActionBtnStencil}" Content="{DynamicResource TxtApply}" Click="BtnApplyTempClean_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- Item 2: Startup Apps -->
                                        <Border Padding="12,8" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="28" Height="28" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                                                    <Path FlowDirection="LeftToRight" Data="M4,6 L20,6 L20,18 L4,18 Z M6,8 L18,8 L18,16 L6,16 Z" Fill="{StaticResource TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource TxtStartupTitleShort}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Medium"/>
                                                    <TextBlock Text="{DynamicResource TxtStartupDescShort}" Foreground="{StaticResource TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" x:Name="TxtRecStartupCount" Text="--" Foreground="{StaticResource PrimaryAccent}" FontSize="10" FontFamily="Consolas, monospace" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Column="3" Style="{StaticResource ActionBtnStencil}" Content="{DynamicResource TxtManage}" Click="BtnApplyStartup_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- Item 3: Recycle Bin -->
                                        <Border Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="28" Height="28" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                                                    <Path FlowDirection="LeftToRight" Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 L6,19 Z" Fill="{StaticResource TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource TxtRecycleTitleShort}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Medium"/>
                                                    <TextBlock Text="{DynamicResource TxtRecycleDescShort}" Foreground="{StaticResource TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" x:Name="TxtRecRecycleBinSize" Text="0 MB" Foreground="{StaticResource PrimaryAccent}" FontSize="10" FontFamily="Consolas, monospace" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Column="3" Style="{StaticResource ActionBtnWarningStencil}" Content="{DynamicResource TxtPurge}" Click="BtnApplyRecycleBin_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- TAB 2: OPTIMIZE (مركز التنظيف والتحسين)       -->
                            <!-- ============================================== -->
                            <StackPanel x:Name="PanelOptimize" Visibility="Collapsed">
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource TxtScanCenter}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtScanSummary" Text="{DynamicResource TxtScanSummaryDefault}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnScanAll" Style="{StaticResource ActionBtnStencil}" Content="{DynamicResource BtnScanAllText}" Click="BtnScanAll_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Module 1: Temp & Prefetch (آمن تماماً) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource TileTempTitle}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Medium"/>
                                            <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                                <Border DockPanel.Dock="Left" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource TxtTempCleanFast}" Foreground="{StaticResource TealHealth}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock x:Name="TxtTempDetails" Text="{DynamicResource TxtTempDetailsDefault}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource ActionBtnStencil}" Content="{DynamicResource BtnCleanSafe}" Click="BtnQuickClean_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Module 2: Recycle Bin (شرط أمان: حذف نهائي مع تأكيد) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource TileRecycleTitle}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Medium"/>
                                            <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                                <Border DockPanel.Dock="Left" Background="#20F59E0B" BorderBrush="#50F59E0B" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource TxtRecycleWarn}" Foreground="{StaticResource AmberWarn}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock x:Name="TxtRecycleBinDetails" Text="{DynamicResource TxtZeroItemsPlaceholder}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource ActionBtnWarningStencil}" Content="{DynamicResource TxtPurge}" Click="BtnEmptyRecycleBin_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Module 3: Browser Cache (شرط أمان: إغلاق المتصفح) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource TileBrowserTitle}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Medium"/>
                                            <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                                <Border DockPanel.Dock="Left" Background="#20F59E0B" BorderBrush="#50F59E0B" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource TxtBrowserWarn}" Foreground="{StaticResource AmberWarn}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock x:Name="TxtBrowserDetails" Text="{DynamicResource TxtBrowserDetailsDefault}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource ActionBtnWarningStencil}" Content="{DynamicResource TxtPurge}" Click="BtnBrowserClean_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Module 4: Dev Caches (شرط أمان: تأكيد تفريغ كاش المطورين) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource TileDevTitle}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Medium"/>
                                            <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                                <Border DockPanel.Dock="Left" Background="#20F59E0B" BorderBrush="#50F59E0B" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource TxtDevWarn}" Foreground="{StaticResource AmberWarn}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock x:Name="TxtDevDetails" Text="{DynamicResource TxtDevDetailsDefault}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource ActionBtnWarningStencil}" Content="{DynamicResource TxtPurge}" Click="BtnDevClean_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Module 5: Memory Optimization (آمن 100%) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource TileWorkingSetTitle}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Medium"/>
                                            <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                                <Border DockPanel.Dock="Left" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource TxtWorkingSetSafe}" Foreground="{StaticResource TealHealth}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource TxtWorkingSetDetailsDefault}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource ActionBtnStencil}" Content="{DynamicResource BtnHeroOptimizeMini}" Click="BtnHeroOptimize_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- TAB 3: DIAGNOSTIC (فحص العتاد والأدوات)         -->
                            <!-- ============================================== -->
                            <StackPanel x:Name="PanelDiagnostic" Visibility="Collapsed">
                                <!-- Telemetry Details Card -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Card Header: Title & Device Model Badge -->
                                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource TxtDiagnosticsTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border DockPanel.Dock="Right" Background="#161B26" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtDeviceModel" Text="Windows PC" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Medium"/>
                                            </Border>
                                        </DockPanel>

                                        <!-- 1. Processor (CPU) -->
                                        <Grid Margin="0,2.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path FlowDirection="LeftToRight" Data="M4,4 L20,4 L20,20 L4,20 Z M8,8 L16,8 L16,16 L8,16 Z M1,9 L4,9 M1,12 L4,12 M1,15 L4,15 M20,9 L23,9 M20,12 L23,12 M20,15 L23,15 M9,1 L9,4 M12,1 L12,4 M15,1 L15,4 M9,20 L9,23 M12,20 L12,23 M15,20 L15,23" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource TxtCpuLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PerfCpuInfo" Text="CPU" Foreground="{StaticResource TextPrimary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 2. Graphics (GPU) -->
                                        <Grid Margin="0,2.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path FlowDirection="LeftToRight" Data="M2,6 L22,6 L22,18 L2,18 Z M6,10 L10,10 M8,8 L8,12 M15,10 A1,1 0 1,0 15,10.01 M18,12 A1,1 0 1,0 18,12.01" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource TxtGpuLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PerfGpuInfo" Text="NVIDIA GPU" Foreground="{StaticResource TextPrimary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 3. Video RAM (VRAM) -->
                                        <Grid x:Name="RowVram" Margin="0,2.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path FlowDirection="LeftToRight" Data="M3,5 L21,5 L21,19 L3,19 Z M3,9 L21,9 M7,13 L11,13 M7,15 L11,15 M15,13 L17,13" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource TxtVramLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PerfVramInfo" Text="VRAM" Foreground="{StaticResource TextPrimary}" FontSize="11" FontFamily="Consolas, monospace" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 4. RAM Hardware Specs -->
                                        <Grid Margin="0,2.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path FlowDirection="LeftToRight" Data="M2,7 L22,7 L22,17 L2,17 Z M5,10 L5,14 M8,10 L8,14 M11,10 L11,14 M14,10 L14,14 M17,10 L17,14" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource TxtRamSpecsLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PerfRamSpecs" Text="RAM" Foreground="{StaticResource TextPrimary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 5. Network Speed & Ping -->
                                        <Grid Margin="0,2.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path FlowDirection="LeftToRight" Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M2,12 L22,12 M12,2 C14.5,5 16,8.5 16,12 C16,15.5 14.5,19 12,22 C9.5,19 8,15.5 8,12 C8,8.5 9.5,5 12,2 Z" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource TxtNetLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="PerfPingInfo" Text="" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="PerfNetDown" Text="↓ 0.0 KB/s" Foreground="{StaticResource TealHealth}" FontSize="11" FontFamily="Consolas, monospace" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="PerfNetUp" Text="↑ 0.0 KB/s" Foreground="{StaticResource PrimaryAccent}" FontSize="11" FontFamily="Consolas, monospace"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 6. System Uptime -->
                                        <Grid Margin="0,2.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path FlowDirection="LeftToRight" Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 1,0 12,2 Z M12,6 L12,12 L16,14" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource TxtUptimeLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PerfUptimeInfo" Text="Uptime" Foreground="{StaticResource TextPrimary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 7. Power / Battery -->
                                        <Grid x:Name="RowPowerBattery" Margin="0,2.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path FlowDirection="LeftToRight" Data="M4,6 L18,6 L18,18 L4,18 Z M20,10 L20,14" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource TxtPowerBatteryLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PerfPowerInfo" Text="Battery" Foreground="{StaticResource TextPrimary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Top Processes -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource TopProcessesTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ItemsControl x:Name="ListTopProcesses">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#141722" BorderBrush="#222738" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Real App Icon or Monogram Fallback Badge -->
                                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="5" Background="#1B202D" BorderBrush="#282F42" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <!-- Real Extracted High-Res Icon -->
                                                                    <Image FlowDirection="LeftToRight" Source="{Binding IconSource}" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasIconVisibility}"/>
                                                                    <!-- Elegant Fallback Monogram Badge -->
                                                                    <TextBlock Text="{Binding Monogram}" Foreground="{StaticResource PrimaryAccent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FallbackIconVisibility}"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Friendly Display Name -->
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                            <!-- RAM Usage Badge -->
                                                            <TextBlock Grid.Column="2" Text="{Binding RamFormatted}" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource ToolTileBtn}" Height="30" Margin="0,8,0,0" Click="BtnGoToProcesses_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path FlowDirection="LeftToRight" Data="M3,5 C3,3.9 3.9,3 5,3 L19,3 C20.1,3 21,3.9 21,5 L21,19 C21,20.1 20.1,21 19,21 L5,21 C3.9,21 3,20.1 3,19 L3,5 Z M5,10 L5,19 L19,19 L19,10 L5,10 Z M7,12 L11,12 L11,14 L7,14 L7,12 Z" Fill="{StaticResource PrimaryAccent}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource BtnViewAllProcesses}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Storage Drives & TRIM -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource TxtStorageDrivesTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ItemsControl x:Name="ListStorageDrives">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding DriveLetter}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="{Binding VolumeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <Border Background="{Binding BadgeBg}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                                            <TextBlock Text="{Binding MediaType}" Foreground="{Binding BadgeFg}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding SpaceSummary}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Style="{StaticResource ActionBtnStencil}" Content="{Binding ActionButtonText}" Visibility="{Binding TrimVisibility}" IsEnabled="{Binding IsTrimEnabled}" ToolTip="{Binding ActionButtonTooltip}" Click="BtnSsdTrim_Click" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <!-- Storage Usage Progress Bar -->
                                                            <ProgressBar Grid.Row="1" Height="4" Minimum="0" Maximum="100" Value="{Binding UsedPercent}" FlowDirection="LeftToRight" Background="#1C2433" Foreground="{Binding ProgressBrush}" BorderThickness="0" Margin="0,6,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Native Windows Tools (الأولويات: مدير المهام وإدارة الأقراص أولاً، ثم الخدمات ومراقب الموارد) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource NativeToolsTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2">
                                            <!-- 1. مدير المهام -->
                                            <Button Style="{StaticResource ToolTileBtn}" Margin="0,0,4,6" Tag="taskmgr" Click="LaunchTool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path FlowDirection="LeftToRight" Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M9,17 L7,17 L7,10 L9,10 L9,17 Z" Fill="{StaticResource PrimaryAccent}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource ToolTaskMgr}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- 2. إدارة الأقراص -->
                                            <Button Style="{StaticResource ToolTileBtn}" Margin="4,0,0,6" Tag="diskmgmt" Click="LaunchTool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path FlowDirection="LeftToRight" Data="M20,13 L4,13 C3.45,13 3,13.45 3,14 L3,18 C3,18.55 3.45,19 4,19 L20,19 C20.55,19 21,18.55 21,18 L21,14 C21,13.45 20.55,13 20,13 Z" Fill="{StaticResource TealHealth}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource ToolDiskMgmt}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- 3. خدمات ويندوز -->
                                            <Button Style="{StaticResource ToolTileBtn}" Margin="0,0,4,0" Tag="services" Click="LaunchTool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path FlowDirection="LeftToRight" Data="M19.14,12.94 C19.17,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.17,11.37 19.14,11.06 L21.16,9.48 C21.34,9.34 21.39,9.08 21.28,8.88 L19.36,5.55 C19.25,5.35 19.01,5.27 18.8,5.35 L16.42,6.31 C15.93,5.93 15.39,5.62 14.81,5.39 L14.45,2.86 C14.41,2.63 14.21,2.46 13.97,2.46 L10.03,2.46 C9.79,2.46 9.59,2.63 9.55,2.86 L9.19,5.39 C8.61,5.62 8.07,5.93 7.58,6.31 L5.2,5.35 C4.99,5.27 4.75,5.35 4.64,5.55 L2.72,8.88 C2.61,9.08 2.66,9.34 2.84,9.48 L4.86,11.06 C4.83,11.37 4.8,11.68 4.8,12 C4.8,12.32 4.83,12.63 4.86,12.94 L2.84,14.52 C2.66,14.66 2.61,14.92 2.72,15.12 L4.64,18.45 C4.75,18.65 4.99,18.73 5.2,18.65 L7.58,17.69 C8.07,18.07 8.61,18.38 9.19,18.61 L9.55,21.14 C9.59,21.37 9.79,21.54 10.03,21.54 L13.97,21.54 C14.21,21.54 14.41,21.37 14.45,21.14 L14.81,18.61 C15.39,18.38 15.93,18.07 16.42,17.69 L18.8,18.65 C19.01,18.73 19.25,18.65 19.36,18.45 L21.28,15.12 C21.39,14.92 21.34,14.66 21.16,14.52 L19.14,12.94 Z M12,15.5 C10.07,15.5 8.5,13.93 8.5,12 C8.5,10.07 10.07,8.5 12,8.5 C13.93,8.5 15.5,10.07 15.5,12 C15.5,13.93 13.93,15.5 12,15.5 Z" Fill="{StaticResource PrimaryAccent}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource ToolServices}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- 4. مراقب الموارد -->
                                            <Button Style="{StaticResource ToolTileBtn}" Margin="4,0,0,0" Tag="resmon" Click="LaunchTool_Click">
