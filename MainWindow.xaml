                                                <DataTemplate>
                                                    <Border Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding DriveLetter}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="{Binding VolumeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <Border Background="{Binding BadgeBg}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                                            <TextBlock Text="{Binding MediaType}" Foreground="{Binding BadgeFg}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding SpaceSummary}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Style="{StaticResource ActionBtnStencil}" Content="{Binding ActionButtonText}" Visibility="{Binding TrimVisibility}" Click="BtnSsdTrim_Click" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <!-- RTL Storage Usage Progress Bar -->
                                                            <ProgressBar Grid.Row="1" Height="4" Minimum="0" Maximum="100" Value="{Binding UsedPercent}" FlowDirection="RightToLeft" Background="#202430" Foreground="{Binding ProgressBrush}" BorderThickness="0" Margin="0,6,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Native Windows Tools (الأولويات: مدير المهام وإدارة الأقراص أولاً، ثم الخدمات ومراقب الموارد) -->
