                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- TAB 4: RUNNING PROCESSES & RAM MANAGER (التطبيقات) -->
                            <!-- ============================================== -->
                            <StackPanel x:Name="PanelProcesses" Visibility="Collapsed">
                                <!-- Summary & Search Card -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource ProcessesTitle}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock x:Name="TxtProcessesSummary" Text="{DynamicResource ProcessesSubTitle}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource ToolTileBtn}" Height="28" Padding="8,0" Click="BtnRefreshProcesses_Click" ToolTip="{DynamicResource BtnRefreshProcesses}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path FlowDirection="LeftToRight" Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 L17.65,6.35 Z" Fill="{StaticResource PrimaryAccent}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{DynamicResource BtnRefreshProcesses}" FontSize="10.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Search Box -->
                                        <Border Background="#121620" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Height="34" Padding="8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" FlowDirection="LeftToRight" Data="M15.5,14 L14.71,14 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 L14,15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z" Fill="{StaticResource TextMuted}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1" x:Name="TxtSearchProcess" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center" TextChanged="TxtSearchProcess_TextChanged" CaretBrush="{StaticResource PrimaryAccent}"/>
                                                <TextBlock Grid.Column="1" x:Name="TxtSearchPlaceholder" Text="{DynamicResource SearchProcessesPlaceholder}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                                                <Button Grid.Column="2" x:Name="BtnClearSearch" Visibility="Collapsed" Style="{StaticResource WindowControlBtn}" Width="20" Height="20" Click="BtnClearSearch_Click">
                                                    <Path FlowDirection="LeftToRight" Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource TextMuted}" StrokeThickness="1.2" Width="7" Height="7" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Processes List -->
                                <TextBlock x:Name="TxtNoProcessesMsg" Text="{DynamicResource TxtNoProcessesFound}" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>
                                <ItemsControl x:Name="ListAllProcesses">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Modern Calm Card Design (No loud neon colors) -->
                                            <Border Background="#141722" BorderBrush="#222738" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Main Row: App Icon + Name/Metadata + RAM + Refined Action Button -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- App Icon (real or fallback) -->
                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1B202D" BorderBrush="#282F42" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Grid>
                                                                <!-- Real icon -->
                                                                <Image FlowDirection="LeftToRight" Source="{Binding IconSource}" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasIconVisibility}"/>
                                                                <!-- Fallback Monogram Badge -->
                                                                <TextBlock Text="{Binding Monogram}" Foreground="{StaticResource PrimaryAccent}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FallbackIconVisibility}"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Display Name + Subtitle (Process names + instances) -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SubtitleText}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- RAM Value + Refined Ghost Action Button -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RamFormatted}" Foreground="#93C5FD" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <Button Height="26" MinWidth="48" Padding="10,0" Tag="{Binding ProcessNamesTag}" Click="BtnEndTask_Click" Visibility="{Binding EndTaskVisibility}" Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="BtnBorder" Background="#1F171A" BorderBrush="#4B2329" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <Path FlowDirection="LeftToRight" Data="M0,0 L7,7 M7,0 L0,7" Stroke="#F87171" StrokeThickness="1.5" Width="7" Height="7" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{DynamicResource BtnEndTask}" Foreground="#F87171" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#331A1F"/>
                                                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#782D38"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#4C1D24"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- RAM Usage Bar (Slim, cohesive) -->
                                                    <ProgressBar Grid.Row="1" Height="2.5" Minimum="0" Maximum="100" Value="{Binding RamPercentOfTotal}" FlowDirection="LeftToRight" Background="#1B202D" Foreground="{StaticResource PrimaryAccent}" BorderThickness="0" Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- TAB 5: SETTINGS (الإعدادات ومعلومات التطبيق)     -->
                            <!-- ============================================== -->
                            <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                                <!-- 0. Language Configuration (اختيار لغة العرض) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SettingsLanguageTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource SettingsLanguageDesc}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnLangEnglish" Grid.Column="0" Height="34" Style="{StaticResource ToolTileBtn}" Click="BtnLangEnglish_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="English" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnLangArabic" Grid.Column="2" Height="34" Style="{StaticResource ToolTileBtn}" Click="BtnLangArabic_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="العربية" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Toolbar Configuration -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SettingsToolbarTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid Margin="0,4">
                                            <TextBlock Text="{DynamicResource SettingsToolbarEnable}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnToggleToolbar" Style="{StaticResource ActionBtnStencil}" Content="{DynamicResource BtnStateEnabled}" HorizontalAlignment="Right" Click="BtnToggleToolbar_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="ToolbarPlacementPanel" Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource SettingsToolbarPlacement}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,6"/>
                                            <UniformGrid Columns="2">
                                                <Button x:Name="BtnDockTop" Style="{StaticResource ToolTileBtn}" Height="32" Content="{DynamicResource BtnDockTop}" Margin="0,0,4,0" Tag="Top" Click="SetDock_Click"/>
                                                <Button x:Name="BtnDockSide" Style="{StaticResource ToolTileBtn}" Height="32" Content="{DynamicResource BtnDockSide}" Margin="4,0,0,0" Tag="Side" Click="SetDock_Click"/>
                                            </UniformGrid>

                                            <!-- Direct Launch Button so user can activate and test immediately -->
                                            <Button x:Name="BtnLaunchToolbar" Style="{StaticResource PrimaryHeroBtn}" Height="36" Margin="0,12,0,0" Click="BtnLaunchToolbar_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path FlowDirection="LeftToRight" Data="M3,5 L21,5 L21,9 L3,9 Z M3,11 L21,11 L21,13 L3,13 Z" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource BtnSwitchToolbarNow}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Boot Performance & Diagnostics Card -->
                                <Border x:Name="BorderBootPerformance" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path FlowDirection="LeftToRight" Data="M13,2 L4,14 L11,14 L9,22 L20,10 L13,10 Z" Fill="{StaticResource PrimaryAccent}" Width="12" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource CardBootPerformanceTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border x:Name="BadgeBootRating" Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtBootRating" Text="{DynamicResource BootNA}" Foreground="{StaticResource TealHealth}" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Boot Metrics Grid (3 Stat Chips) -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Chip 1: BIOS Time -->
                                            <Border Grid.Column="0" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtBiosTimeLabel}" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                                    <TextBlock x:Name="TxtBiosTimeVal" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" FontFamily="Consolas, monospace"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Chip 2: Est. Total Boot -->
                                            <Border Grid.Column="1" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="2,0,2,0">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource BootLastDuration}" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                                    <TextBlock x:Name="TxtTotalBootVal" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" FontFamily="Consolas, monospace"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Chip 3: Active Apps Delay -->
                                            <Border Grid.Column="2" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtActiveImpactLabel}" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                                    <TextBlock x:Name="TxtAppsDelayVal" Text="--" Foreground="{StaticResource AmberWarn}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" FontFamily="Consolas, monospace"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- 4th Row: Boot At & Uptime Telemetry -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtBootAt" Text="--" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtBootUptime" Text="--" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Tier 2: Real Boot Measurement (Requires Admin) -->
                                        <StackPanel Margin="0,0,0,10">
                                            <Button x:Name="BtnMeasureBoot" Style="{StaticResource ActionBtnStencil}" Content="{DynamicResource BootMeasureBtn}" Click="BtnMeasureBoot_Click" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                            <TextBlock Text="{DynamicResource BootNeedsAdmin}" Foreground="{StaticResource TextMuted}" FontSize="9.5" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Smart Optimization Advice Callout -->
                                        <Border Background="#121826" BorderBrush="#302563EB" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="💡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" x:Name="TxtBootTip" Text="Startup list: disabling non-essential background applications helps improve boot responsiveness." Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Start Tempo with Windows Card -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsStartWithWindowsTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource SettingsStartWithWindowsDesc}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartWithWindows" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Cursor="Hand" Click="ChkStartWithWindows_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Startup Apps Manager: Grouped by Sensitivity -->
                                <!-- Group 1: Security & Essential Services -->
                                <Border x:Name="BorderStartupSecurityApps" Background="{StaticResource SurfaceContainer}" BorderBrush="#55FFB77D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource SettingsStartupSecurityGroup}" Foreground="#FFB77D" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Background="#20FFB77D" BorderBrush="#50FFB77D" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtSecurityAppsCount" Text="0" Foreground="#FFB77D" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl x:Name="ListStartupSecurityApps" ItemTemplate="{StaticResource StartupAppItemTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Group 2: Regular User Startup Applications -->
                                <Border x:Name="BorderStartupRegularApps" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource SettingsStartupRegularGroup}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtRegularAppsCount" Text="0" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Style="{StaticResource ActionBtnStencil}" Content="{DynamicResource BtnOpenWindowsStartup}" HorizontalAlignment="Right" Click="BtnOpenStartupSettings_Click"/>
                                        </Grid>
                                        <ItemsControl x:Name="ListStartupRegularApps" ItemTemplate="{StaticResource StartupAppItemTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Updates Section (فحص وإدارة التحديثات) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource SettingsUpdatesTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border x:Name="BorderSettingsUpdateStatus" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtSettingsUpdateBadge" Text="{DynamicResource TxtUpToDate}" Foreground="{StaticResource TealHealth}" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="TxtSettingsLastCheck" Text="{DynamicResource TxtLastCheckRecent}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,10"/>
                                        <Button x:Name="BtnCheckUpdatesManual" Style="{StaticResource ToolTileBtn}" Height="32" Click="BtnCheckUpdatesManual_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path FlowDirection="LeftToRight" Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 L17.65,6.35 Z" Fill="{StaticResource PrimaryAccent}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource BtnCheckUpdates}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- About Tempo -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="10" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <Image FlowDirection="LeftToRight" x:Name="ImgAboutLogo" RenderOptions.BitmapScalingMode="HighQuality" Margin="4"/>
                                        </Border>
                                        <TextBlock Text="Tempo Diagnostic &amp; PC Optimizer" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAboutVersion" Text="--" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="Consolas, monospace" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                        <TextBlock x:Name="TxtAboutAuthor" Text="Designed &amp; Engineered by Eng. Abdelrahman Emam" Foreground="{StaticResource PrimaryAccent}" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- TAB 6: FEEDBACK (الملاحظات والاقتراحات)        -->
                            <!-- ============================================== -->
                            <StackPanel x:Name="PanelFeedback" Visibility="Collapsed">
                                <!-- Header Card -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource FeedbackTitle}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource FeedbackSubTitle}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"/>
                                    </StackPanel>
                                </Border>

                                <!-- Form Card -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Feedback Category Radio/Pills -->
                                        <TextBlock Text="{DynamicResource FeedbackTypeLabel}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="RadioFeedbackBug" Grid.Column="0" Style="{StaticResource SegmentedRadioBtn}" Content="{DynamicResource FeedbackTypeBug}" GroupName="FeedbackType" IsChecked="True" Margin="0,0,4,0"/>
                                            <RadioButton x:Name="RadioFeedbackFeature" Grid.Column="1" Style="{StaticResource SegmentedRadioBtn}" Content="{DynamicResource FeedbackTypeFeature}" GroupName="FeedbackType" Margin="0,0,4,0"/>
                                            <RadioButton x:Name="RadioFeedbackGeneral" Grid.Column="2" Style="{StaticResource SegmentedRadioBtn}" Content="{DynamicResource FeedbackTypeGeneral}" GroupName="FeedbackType"/>
                                        </Grid>

                                        <!-- Name / Email (Optional) -->
                                        <TextBlock Text="{DynamicResource FeedbackNameLabel}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <Border Background="#121620" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Height="34" Padding="10,0" Margin="0,0,0,12">
                                            <Grid>
                                                <TextBox x:Name="TxtFeedbackSender" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center" CaretBrush="{StaticResource PrimaryAccent}" TextChanged="TxtFeedbackSender_TextChanged"/>
                                                <TextBlock x:Name="TxtFeedbackSenderPlaceholder" Text="{DynamicResource FeedbackNamePlaceholder}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>

                                        <!-- Message Details -->
                                        <TextBlock Text="{DynamicResource FeedbackMessageLabel}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <Border Background="#121620" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Height="100" Padding="10,8" Margin="0,0,0,12">
                                            <Grid>
                                                <TextBox x:Name="TxtFeedbackMessage" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="11" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" CaretBrush="{StaticResource PrimaryAccent}" TextChanged="TxtFeedbackMessage_TextChanged"/>
                                                <TextBlock x:Name="TxtFeedbackMessagePlaceholder" Text="{DynamicResource FeedbackMessagePlaceholder}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Include System Specs Checkbox -->
                                        <CheckBox x:Name="ChkIncludeSpecs" IsChecked="True" Content="{DynamicResource FeedbackIncludeSpecs}" Foreground="{StaticResource TextSecondary}" FontSize="10" Cursor="Hand" Margin="0,0,0,14"/>

                                        <!-- Submit Button -->
                                        <Button x:Name="BtnSubmitFeedback" Style="{StaticResource PrimaryHeroBtn}" Height="34" HorizontalAlignment="Stretch" Click="BtnSubmitFeedback_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path FlowDirection="LeftToRight" Data="M2.01,21 L23,12 L2.01,3 L2,10 L17,12 L2,14 L2.01,21 Z" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource BtnSendFeedback}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TOAST NOTIFICATION BANNER (Exclusively inside MainDashboardView, spanning full dashboard width) -->
                <Border x:Name="ToastBanner"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="16,0,16,24"
                        Background="#F5141722"
                        BorderBrush="{StaticResource TealHealth}"
                        BorderThickness="1.2"
                        CornerRadius="8"
                        Padding="16,9"
                        Panel.ZIndex="999">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.6"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path FlowDirection="LeftToRight" x:Name="ToastIcon" Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M10,17 L5,12 L6.41,10.59 L10,14.17 L17.59,6.58 L19,8 L10,17 Z" Fill="{StaticResource TealHealth}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToastText" Text="{DynamicResource TxtActionCompleted}" Foreground="{StaticResource TealHealth}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2A. FLOATING PILL COMPANION BAR (كبسولة عائمة فائقة البساطة والسلاسة) -->
        <Border x:Name="CompanionBarHorizontal"
                Visibility="Collapsed"
                Background="#EE0B0E14"
                BorderBrush="#222D3E"
                BorderThickness="1"
                CornerRadius="19"
                Padding="12,0"
                Height="38"
                Cursor="SizeAll"
                FlowDirection="LeftToRight">
            <Border.Effect>
                <DropShadowEffect x:Name="ToolbarGlowH" Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
            </Border.Effect>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Brand & Pulse -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Separator -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Metrics: CPU & RAM -->
                    <ColumnDefinition Width="*"/>
                    <!-- Separator -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Actions -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Brand & Health Pulse -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Image FlowDirection="LeftToRight" x:Name="ImgToolbarLogoH" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <Ellipse x:Name="ToolbarPulseDotH" Width="6" Height="6" Fill="{StaticResource TealHealth}" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ToolbarPulseScaleH" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="Tempo" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Grid.Column="1" Width="1" Height="14" Fill="#232D3F" Margin="10,0"/>

                <!-- 2. Circular KPI Gauges: CPU & RAM -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- CPU KPI Dial -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource ToolbarTooltipCpu}">
                        <TextBlock Text="CPU" Foreground="#94A3B8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                            <!-- Background Track Ring -->
                            <Ellipse Width="25" Height="25" Stroke="#1E283A" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Active Arc -->
                            <Path x:Name="BarCpuKpiArcH" Stroke="{StaticResource TealHealth}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <!-- Percentage in Center -->
                            <TextBlock x:Name="BarCpuTextH" Text="--" Foreground="{StaticResource TealHealth}" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="14" Fill="#232D3F" Margin="10,0"/>

                    <!-- RAM KPI Dial -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource ToolbarTooltipRam}">
                        <TextBlock Text="RAM" Foreground="#94A3B8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                            <!-- Background Track Ring -->
                            <Ellipse Width="25" Height="25" Stroke="#1E283A" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Active Arc -->
                            <Path x:Name="BarRamKpiArcH" Stroke="{StaticResource TealHealth}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <!-- Percentage in Center -->
                            <TextBlock x:Name="BarRamTextH" Text="--" Foreground="{StaticResource TealHealth}" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Grid.Column="3" Width="1" Height="14" Fill="#232D3F" Margin="10,0"/>

                <!-- 3. Minimalist Actions -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Update Badge Button (Shown only when update available) -->
                    <Button x:Name="BtnToolbarUpdateH" Style="{StaticResource ToolbarUpdateBtn}" Width="24" Height="24" Margin="0,0,3,0" Click="BtnUpdateBadge_Click" Visibility="Collapsed" ToolTip="{DynamicResource BtnTooltipUpdate}">
                        <Path FlowDirection="LeftToRight" Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Turbo Boost Button -->
                    <Button x:Name="BtnToolbarBoostH" Style="{StaticResource ToolbarBoostBtn}" Width="24" Height="24" Margin="0,0,3,0" Click="BtnToolbarBoost_Click" ToolTip="{DynamicResource ToolbarTooltipBoost}" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="BtnToolbarBoostScaleH" ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Path FlowDirection="LeftToRight" x:Name="ToolbarBoostIconH" Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#38BDF8" Width="10" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ToolbarBoostScaleH" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ToolbarBoostRotateH" Angle="0"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Button>

                    <!-- Open Dashboard Button -->
                    <Button Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Margin="0,0,2,0" Click="BtnOpenDashboard_Click" ToolTip="{DynamicResource ToolbarTooltipOpenDashboard}">
                        <Path FlowDirection="LeftToRight" Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z" Fill="{StaticResource TextSecondary}" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>

                    <!-- Pin Button -->
                    <Button Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Margin="0,0,2,0" Click="BtnToolbarPin_Click" ToolTip="{DynamicResource ToolbarTooltipPin}">
                        <Path FlowDirection="LeftToRight" x:Name="ToolbarPinIconH" Data="M16,12 L16,4 L17,4 L17,2 L7,2 L7,4 L8,4 L8,12 L6,14 L6,16 L11,16 L11,22 L13,22 L13,16 L18,16 L18,14 L16,12 Z" Fill="{StaticResource TextSecondary}" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>

                    <!-- Close / Hide Button -->
                    <Button Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Click="BtnToolbarClose_Click" ToolTip="{DynamicResource ToolbarTooltipHide}">
                        <Path FlowDirection="LeftToRight" Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" SnapsToDevicePixels="True" Width="8" Height="8" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- UPDATE MODAL OVERLAY (نافذة التحديث المنبثقة)     -->
        <!-- ============================================== -->
        <Grid x:Name="UpdateModalOverlay" Visibility="Collapsed" Background="#D0080A0F" Panel.ZIndex="9999">
            <Border Background="#161923" BorderBrush="#0066FF" BorderThickness="1.2" CornerRadius="14" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#0066FF" BlurRadius="30" ShadowDepth="0" Opacity="0.38"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" Background="#10B981" CornerRadius="14" Margin="0,0,8,0">
                                <Path FlowDirection="LeftToRight" Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource UpdateModalTitle}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtModalVersionDiff" Text="" Foreground="{StaticResource PrimaryAccent}" FontSize="10" FontFamily="Consolas, monospace"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource WindowControlBtn}" Width="24" Height="24" HorizontalAlignment="Left" Click="BtnCloseUpdateModal_Click">
                            <Path FlowDirection="LeftToRight" Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" Width="8" Height="8" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Release Notes Box -->
                    <TextBlock Text="{DynamicResource UpdateModalWhatNew}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="#0D1017" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Height="130" Padding="10" Margin="0,0,0,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtModalReleaseNotes" Text="{DynamicResource TxtGettingReleaseNotes}" Foreground="{StaticResource TextPrimary}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Progress Bar Container -->
                    <StackPanel x:Name="PanelUpdateProgress" Visibility="Collapsed" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtUpdateProgressStatus" Grid.Column="0" Text="{DynamicResource TxtUpdateProgressStatus}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtUpdateProgressPercent" Grid.Column="1" Text="0%" Foreground="{StaticResource TealHealth}" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <ProgressBar x:Name="BarUpdateProgress" Height="6" Background="#1D2027" Foreground="#10B981" BorderThickness="0" Value="0" Maximum="100"/>
                    </StackPanel>

                    <!-- Error Alert Banner -->
                    <Border x:Name="BorderUpdateError" Visibility="Collapsed" Background="#2A1417" BorderBrush="{StaticResource RedAlert}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtUpdateErrorMsg" Text="{DynamicResource TxtUpdateError}" Foreground="{StaticResource RedAlert}" FontSize="10" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel x:Name="PanelUpdateActions" Orientation="Vertical">
                        <Button x:Name="BtnModalUpdateNow" Style="{StaticResource PrimaryHeroBtn}" Background="#10B981" Height="36" Margin="0,0,0,8" Click="BtnModalUpdateNow_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BtnModalUpdateNow}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnModalRemindLater" Grid.Column="0" Style="{StaticResource ToolTileBtn}" Height="30" Margin="0,0,4,0" Content="{DynamicResource BtnModalRemindLater}" Click="BtnModalRemindLater_Click"/>
                            <Button x:Name="BtnModalSkipVersion" Grid.Column="1" Style="{StaticResource ToolTileBtn}" Height="30" Margin="4,0,0,0" Content="{DynamicResource BtnModalSkipVersion}" Click="BtnModalSkipVersion_Click"/>
                        </Grid>
                        <Button x:Name="BtnModalViewDetails" Height="26" MaxWidth="337" Margin="0,8,0,0" HorizontalAlignment="Center" Cursor="Hand" Click="BtnModalViewDetails_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="8,4">
                                        <TextBlock x:Name="tb" Text="{DynamicResource BtnModalViewDetails}" Foreground="{StaticResource PrimaryAccent}" FontSize="10.5" FontWeight="SemiBold" TextDecorations="Underline"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1A2536"/>
                                            <Setter TargetName="tb" Property="Foreground" Value="#60A5FA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2B. VERTICAL COMPANION BAR (الجانب - كبسولة عمودية فائقة النحافة 34px وبدون زخارف زائدة) -->
        <!-- 2B. VERTICAL FLOATING PILL (كبسولة عائمة عمودية فائقة البساطة والسلاسة بـ KPI Dials) -->
        <Border x:Name="CompanionBarVertical"
                Visibility="Collapsed"
                Background="#EE0B0E14"
                BorderBrush="#252F42"
                BorderThickness="1"
                CornerRadius="19"
                Padding="0,10"
                Width="38"
                Height="295"
                Cursor="SizeAll"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 1. Brand Logo & Status Pulse Dot -->
                <Grid Width="16" Height="16" Margin="0,0,0,4" HorizontalAlignment="Center">
                    <Image FlowDirection="LeftToRight" x:Name="ImgToolbarLogoV" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Ellipse x:Name="ToolbarPulseDotV" Width="6" Height="6" Fill="{StaticResource TealHealth}" HorizontalAlignment="Center" Margin="0,0,0,2" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="ToolbarPulseScaleV" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Rectangle Height="1" Width="18" Fill="#232D3F" Margin="0,6,0,6"/>

                <!-- 2. CPU Circular KPI Dial -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" ToolTip="{DynamicResource ToolbarTooltipCpu}">
                    <TextBlock Text="CPU" Foreground="#94A3B8" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <Grid Width="28" Height="28" HorizontalAlignment="Center">
                        <Ellipse Width="25" Height="25" Stroke="#1E283A" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="BarCpuKpiArcV" Stroke="{StaticResource TealHealth}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock x:Name="BarCpuTextV" Text="--" Foreground="{StaticResource TealHealth}" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <Rectangle Height="1" Width="18" Fill="#232D3F" Margin="0,6,0,6"/>

                <!-- 3. RAM Circular KPI Dial -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" ToolTip="{DynamicResource ToolbarTooltipRam}">
                    <TextBlock Text="RAM" Foreground="#94A3B8" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <Grid Width="28" Height="28" HorizontalAlignment="Center">
                        <Ellipse Width="25" Height="25" Stroke="#1E283A" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="BarRamKpiArcV" Stroke="{StaticResource TealHealth}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock x:Name="BarRamTextV" Text="--" Foreground="{StaticResource TealHealth}" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <Rectangle Height="1" Width="18" Fill="#232D3F" Margin="0,6,0,6"/>

                <!-- 4. Action Buttons -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <!-- Update Badge Button (Shown only when update available) -->
                    <Button x:Name="BtnToolbarUpdateV" Style="{StaticResource ToolbarUpdateBtn}" Width="24" Height="24" Margin="0,0,0,4" Click="BtnUpdateBadge_Click" Visibility="Collapsed" ToolTip="{DynamicResource BtnTooltipUpdate}">
                        <Path FlowDirection="LeftToRight" Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Turbo Boost Button -->
                    <Button x:Name="BtnToolbarBoostV" Style="{StaticResource ToolbarBoostBtn}" Width="24" Height="24" Margin="0,0,0,4" Click="BtnToolbarBoost_Click" ToolTip="{DynamicResource ToolbarTooltipBoost}" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="BtnToolbarBoostScaleV" ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Path FlowDirection="LeftToRight" x:Name="ToolbarBoostIconV" Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#38BDF8" Width="10" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ToolbarBoostScaleV" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ToolbarBoostRotateV" Angle="0"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Button>

                    <!-- Open Dashboard Button -->
                    <Button Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Margin="0,0,0,3" Click="BtnOpenDashboard_Click" ToolTip="{DynamicResource ToolbarTooltipOpenDashboard}">
                        <Path FlowDirection="LeftToRight" Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z" Fill="{StaticResource TextSecondary}" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>

                    <!-- Auto-Hide / Pin Toggle -->
                    <Button Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Margin="0,0,0,3" Click="BtnToolbarPin_Click" ToolTip="{DynamicResource ToolbarTooltipPin}">
                        <Path FlowDirection="LeftToRight" x:Name="ToolbarPinIconV" Data="M16,12 L16,4 L17,4 L17,2 L7,2 L7,4 L8,4 L8,12 L6,14 L6,16 L11,16 L11,22 L13,22 L13,16 L18,16 L18,14 L16,12 Z" Fill="{StaticResource TextSecondary}" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>

                    <!-- Close / Minimize -->
                    <Button Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Click="BtnToolbarClose_Click" ToolTip="{DynamicResource ToolbarTooltipHide}">
                        <Path FlowDirection="LeftToRight" Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" SnapsToDevicePixels="True" Width="8" Height="8" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
