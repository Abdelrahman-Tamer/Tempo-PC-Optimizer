                                                </StackPanel>
                                            </Button>
                                            <!-- 3. خدمات ويندوز -->
                                            <Button Style="{StaticResource ToolTileBtn}" Margin="0,0,4,0" Tag="services" Click="LaunchTool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M19.14,12.94 C19.17,12.63 19.2,12.32 19.2,12 C19.2,11.68 19.17,11.37 19.14,11.06 L21.16,9.48 C21.34,9.34 21.39,9.08 21.28,8.88 L19.36,5.55 C19.25,5.35 19.01,5.27 18.8,5.35 L16.42,6.31 C15.93,5.93 15.39,5.62 14.81,5.39 L14.45,2.86 C14.41,2.63 14.21,2.46 13.97,2.46 L10.03,2.46 C9.79,2.46 9.59,2.63 9.55,2.86 L9.19,5.39 C8.61,5.62 8.07,5.93 7.58,6.31 L5.2,5.35 C4.99,5.27 4.75,5.35 4.64,5.55 L2.72,8.88 C2.61,9.08 2.66,9.34 2.84,9.48 L4.86,11.06 C4.83,11.37 4.8,11.68 4.8,12 C4.8,12.32 4.83,12.63 4.86,12.94 L2.84,14.52 C2.66,14.66 2.61,14.92 2.72,15.12 L4.64,18.45 C4.75,18.65 4.99,18.73 5.2,18.65 L7.58,17.69 C8.07,18.07 8.61,18.38 9.19,18.61 L9.55,21.14 C9.59,21.37 9.79,21.54 10.03,21.54 L13.97,21.54 C14.21,21.54 14.41,21.37 14.45,21.14 L14.81,18.61 C15.39,18.38 15.93,18.07 16.42,17.69 L18.8,18.65 C19.01,18.73 19.25,18.65 19.36,18.45 L21.28,15.12 C21.39,14.92 21.34,14.66 21.16,14.52 L19.14,12.94 Z M12,15.5 C10.07,15.5 8.5,13.93 8.5,12 C8.5,10.07 10.07,8.5 12,8.5 C13.93,8.5 15.5,10.07 15.5,12 C15.5,13.93 13.93,15.5 12,15.5 Z" Fill="{StaticResource PrimaryAccent}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource ToolServices}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- 4. مراقب الموارد -->
                                            <Button Style="{StaticResource ToolTileBtn}" Margin="4,0,0,0" Tag="resmon" Click="LaunchTool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M12,4 A8,8 0 0,0 4,12 C4,14.2 4.9,16.2 6.3,17.7 L12,12 L17.7,17.7 C19.1,16.2 20,14.2 20,12 A8,8 0 0,0 12,4 Z" Fill="{StaticResource AmberWarn}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource ToolResMon}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- TAB 4: SETTINGS (الإعدادات ومعلومات التطبيق)     -->
                            <!-- ============================================== -->
                            <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                                <!-- 0. Language Configuration (اختيار لغة العرض) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SettingsLanguageTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource SettingsLanguageDesc}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnLangEnglish" Grid.Column="0" Height="34" Style="{StaticResource ToolTileBtn}" Click="BtnLangEnglish_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🇬🇧 English (Default)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnLangArabic" Grid.Column="2" Height="34" Style="{StaticResource ToolTileBtn}" Click="BtnLangArabic_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🇪🇬 العربية" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Toolbar Configuration -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SettingsToolbarTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid Margin="0,4">
                                            <TextBlock Text="{DynamicResource SettingsToolbarEnable}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnToggleToolbar" Style="{StaticResource ActionBtnStencil}" Content="مفعّل" HorizontalAlignment="Right" Click="BtnToggleToolbar_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="ToolbarPlacementPanel" Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource SettingsToolbarPlacement}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,6"/>
                                            <UniformGrid Columns="2">
                                                <Button x:Name="BtnDockTop" Style="{StaticResource ToolTileBtn}" Height="32" Content="{DynamicResource BtnDockTop}" Margin="0,0,4,0" Tag="Top" Click="SetDock_Click"/>
                                                <Button x:Name="BtnDockSide" Style="{StaticResource ToolTileBtn}" Height="32" Content="{DynamicResource BtnDockSide}" Margin="4,0,0,0" Tag="Side" Click="SetDock_Click"/>
                                            </UniformGrid>

                                            <!-- Direct Launch Button so user can activate and test immediately -->
                                            <Button x:Name="BtnLaunchToolbar" Style="{StaticResource PrimaryHeroBtn}" Height="36" Margin="0,12,0,0" Click="BtnLaunchToolbar_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M3,5 L21,5 L21,9 L3,9 Z M3,11 L21,11 L21,13 L3,13 Z" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource BtnSwitchToolbarNow}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Startup Apps Manager: Grouped by Sensitivity -->
                                <!-- Group 1: Security & Essential Services -->
                                <Border x:Name="BorderStartupSecurityApps" Background="{StaticResource SurfaceContainer}" BorderBrush="#55FFB77D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource SettingsStartupSecurityGroup}" Foreground="#FFB77D" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Background="#20FFB77D" BorderBrush="#50FFB77D" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtSecurityAppsCount" Text="0" Foreground="#FFB77D" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl x:Name="ListStartupSecurityApps" ItemTemplate="{StaticResource StartupAppItemTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Group 2: Regular User Startup Applications -->
                                <Border x:Name="BorderStartupRegularApps" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource SettingsStartupRegularGroup}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtRegularAppsCount" Text="0" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Style="{StaticResource ActionBtnStencil}" Content="{DynamicResource BtnOpenWindowsStartup}" HorizontalAlignment="Right" Click="BtnOpenStartupSettings_Click"/>
                                        </Grid>
                                        <ItemsControl x:Name="ListStartupRegularApps" ItemTemplate="{StaticResource StartupAppItemTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Updates Section (فحص وإدارة التحديثات) -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource SettingsUpdatesTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border x:Name="BorderSettingsUpdateStatus" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtSettingsUpdateBadge" Text="النسخة الأحدث" Foreground="{StaticResource TealHealth}" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="TxtSettingsLastCheck" Text="آخر فحص: منذ قليل" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,10"/>
                                        <Button x:Name="BtnCheckUpdatesManual" Style="{StaticResource ToolTileBtn}" Height="32" Click="BtnCheckUpdatesManual_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 L17.65,6.35 Z" Fill="{StaticResource PrimaryAccent}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource BtnCheckUpdates}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- About Tempo -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="10" Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <Image x:Name="ImgAboutLogo" RenderOptions.BitmapScalingMode="HighQuality" Margin="4"/>
                                        </Border>
                                        <TextBlock Text="Tempo Diagnostic &amp; PC Optimizer" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Version 2.2.0 (Windows Native x64)" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="Consolas, monospace" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                        <TextBlock Text="Designed &amp; Engineered by Eng. Abdelrahman Emam" Foreground="{StaticResource PrimaryAccent}" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- 2A. HORIZONTAL COMPANION BAR (أعلى الشاشة - كبسولة أفقية نحيفة) -->
        <Border x:Name="CompanionBarHorizontal"
                Visibility="Collapsed"
                Background="#F010131B"
                BorderBrush="#550066FF"
                BorderThickness="1.2"
                CornerRadius="21"
                Padding="8,4"
                Height="42"
                FlowDirection="RightToLeft">
            <Border.Effect>
                <DropShadowEffect Color="#0066FF" BlurRadius="18" ShadowDepth="0" Opacity="0.28"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,5,0" Opacity="0.4" Cursor="SizeAll">
                        <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                        <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                        <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <Grid Width="24" Height="24" Margin="0,0,5,0">
                        <Image x:Name="ImgToolbarLogoH" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>

                    <Ellipse x:Name="ToolbarPulseDotH" Width="6" Height="6" Fill="{StaticResource TealHealth}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Tempo" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="16" Fill="#2D343F" Margin="8,0"/>
                </StackPanel>

                <!-- Metric Pods Container (LTR for numeric metrics so % and arrows don't reverse) -->
                <StackPanel x:Name="ToolbarMetricsContainerH" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <!-- RAM Pod -->
                    <Border Style="{StaticResource ToolbarPodStyle}" Height="28" Padding="6,2" ToolTip="استهلاك الذاكرة (RAM)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="BarRamIconH" Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M12,4 A8,8 0 1,1 4,12 A8,8 0 0,1 12,4 Z" Fill="{StaticResource TealHealth}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RAM " Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BarRamTextH" Text="42%" Foreground="{StaticResource TealHealth}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- CPU Pod -->
                    <Border Style="{StaticResource ToolbarPodStyle}" Height="28" Padding="6,2" ToolTip="استهلاك المعالج (CPU)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="BarCpuIconH" Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M9,17 L7,17 L7,10 L9,10 L9,17 Z" Fill="{StaticResource TealHealth}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CPU " Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BarCpuTextH" Text="12%" Foreground="{StaticResource TealHealth}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- NET Speed Pod -->
                    <Border Style="{StaticResource ToolbarPodStyle}" Height="28" Padding="6,2" ToolTip="حركة نقل الشبكة">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↓ " Foreground="{StaticResource TealHealth}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BarNetSpeedH" Text="0.0 KB/s" Foreground="{StaticResource TealHealth}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Inline Toolbar Toast Alert (يظهر داخل التول بار بنص عربي مقروء بدون قص أو تشويه) -->
                <Border x:Name="ToolbarToastH"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Background="#191D29"
                        BorderBrush="{StaticResource TealHealth}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="10,2"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="ToolbarToastIconH" Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M10,17 L5,12 L6.41,10.59 L10,14.17 L17.59,6.58 L19,8 L10,17 Z" Fill="{StaticResource TealHealth}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToolbarToastTextH" Text="تمت العملية بنجاح" Foreground="{StaticResource TealHealth}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Toolbar Update Badge Button -->
                    <Button x:Name="BtnToolbarUpdateH" Style="{StaticResource ToolbarBoostBtn}" Width="28" Height="28" Margin="0,0,5,0" Click="BtnUpdateBadge_Click" Visibility="Collapsed" ToolTip="تحديث جديد متوفر للبرنامج">
                        <Border Background="#10B981" CornerRadius="14" Width="28" Height="28">
                            <Path Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>

                    <Button x:Name="BtnToolbarBoostH" Style="{StaticResource ToolbarBoostBtn}" Width="28" Height="28" Margin="0,0,5,0" Click="BtnToolbarBoost_Click" ToolTip="{DynamicResource ToolbarTooltipBoost}">
                        <Path x:Name="ToolbarBoostIconH" Data="M11,21 L13,13 L19,13 L8,2 L9,10 L3,10 Z" Fill="#FFFFFF" Width="11" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Button>

                    <Button Style="{StaticResource ToolbarIconBtn}" Width="26" Height="26" Margin="0,0,3,0" Click="BtnOpenDashboard_Click" ToolTip="{DynamicResource ToolbarTooltipOpenDashboard}">
                        <Path Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z" Fill="{StaticResource PrimaryAccent}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource ToolbarIconBtn}" Width="26" Height="26" Margin="0,0,3,0" Click="BtnToolbarPin_Click" ToolTip="{DynamicResource ToolbarTooltipPin}">
                        <Path x:Name="ToolbarPinIconH" Data="M16,12 L16,4 L17,4 L17,2 L7,2 L7,4 L8,4 L8,12 L6,14 L6,16 L11,16 L11,22 L13,22 L13,16 L18,16 L18,14 L16,12 Z" Fill="{StaticResource PrimaryAccent}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource ToolbarIconBtn}" Width="26" Height="26" Click="BtnToolbarClose_Click" ToolTip="{DynamicResource ToolbarTooltipHide}">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" SnapsToDevicePixels="True" Width="8" Height="8" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- UPDATE MODAL OVERLAY (نافذة التحديث المنبثقة)     -->
        <!-- ============================================== -->
        <Grid x:Name="UpdateModalOverlay" Visibility="Collapsed" Background="#D0080A0F" Panel.ZIndex="9999">
            <Border Background="#161923" BorderBrush="#0066FF" BorderThickness="1.2" CornerRadius="14" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#0066FF" BlurRadius="30" ShadowDepth="0" Opacity="0.38"/>
                </Border.Effect>
                <StackPanel FlowDirection="RightToLeft">
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" Background="#10B981" CornerRadius="14" Margin="0,0,8,0">
                                <Path Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource UpdateModalTitle}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtModalVersionDiff" Text="v2.2.0  ➔  v2.3.0" Foreground="{StaticResource PrimaryAccent}" FontSize="10" FontFamily="Consolas, monospace"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource WindowControlBtn}" Width="24" Height="24" HorizontalAlignment="Left" Click="BtnCloseUpdateModal_Click">
                            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" Width="8" Height="8" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Release Notes Box -->
                    <TextBlock Text="{DynamicResource UpdateModalWhatNew}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="#0D1017" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Height="130" Padding="10" Margin="0,0,0,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtModalReleaseNotes" Text="جاري جلب تفاصيل التحديث..." Foreground="{StaticResource TextPrimary}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Progress Bar Container -->
                    <StackPanel x:Name="PanelUpdateProgress" Visibility="Collapsed" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <TextBlock x:Name="TxtUpdateProgressStatus" Text="جاري التنزيل والتحقق من البصمة..." Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                            <TextBlock x:Name="TxtUpdateProgressPercent" Text="0%" Foreground="{StaticResource TealHealth}" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Left"/>
                        </Grid>
                        <ProgressBar x:Name="BarUpdateProgress" Height="6" Background="#1D2027" Foreground="#10B981" BorderThickness="0" Value="0" Maximum="100"/>
                    </StackPanel>

                    <!-- Error Alert Banner -->
                    <Border x:Name="BorderUpdateError" Visibility="Collapsed" Background="#2A1417" BorderBrush="{StaticResource RedAlert}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtUpdateErrorMsg" Text="حدث خطأ أثناء التحديث" Foreground="{StaticResource RedAlert}" FontSize="10" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel x:Name="PanelUpdateActions" Orientation="Vertical">
                        <Button x:Name="BtnModalUpdateNow" Style="{StaticResource PrimaryHeroBtn}" Background="#10B981" Height="36" Margin="0,0,0,8" Click="BtnModalUpdateNow_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BtnModalUpdateNow}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnModalRemindLater" Grid.Column="0" Style="{StaticResource ToolTileBtn}" Height="30" Margin="0,0,4,0" Content="{DynamicResource BtnModalRemindLater}" Click="BtnModalRemindLater_Click"/>
                            <Button x:Name="BtnModalSkipVersion" Grid.Column="1" Style="{StaticResource ToolTileBtn}" Height="30" Margin="4,0,0,0" Content="{DynamicResource BtnModalSkipVersion}" Click="BtnModalSkipVersion_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2B. VERTICAL COMPANION BAR (الجانب - كبسولة عمودية فائقة النحافة 34px وبدون زخارف زائدة) -->
        <Border x:Name="CompanionBarVertical"
                Visibility="Collapsed"
                Background="#F010131B"
                BorderBrush="#550066FF"
                BorderThickness="1"
                CornerRadius="17"
                Padding="2,6"
                Width="34"
                Height="255"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#0066FF" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Compact Grip Dots -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.4" Cursor="SizeAll">
                    <Ellipse Width="2" Height="2" Fill="{StaticResource TextSecondary}" Margin="0,0,1.5,0"/>
                    <Ellipse Width="2" Height="2" Fill="{StaticResource TextSecondary}" Margin="0,0,1.5,0"/>
                    <Ellipse Width="2" Height="2" Fill="{StaticResource TextSecondary}"/>
                </StackPanel>

                <!-- Clean 3D Logo (بدون نقطة خضراء أو إطارات زخرفية) -->
                <Grid Width="20" Height="20" Margin="0,0,0,5">
                    <Image x:Name="ImgToolbarLogoV" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <!-- Vertical Toolbar Update Badge Button -->
                <Button x:Name="BtnToolbarUpdateV" Style="{StaticResource ToolbarBoostBtn}" Width="22" Height="22" Margin="0,0,0,4" Click="BtnUpdateBadge_Click" Visibility="Collapsed" ToolTip="تحديث جديد متوفر">
                    <Border Background="#10B981" CornerRadius="11" Width="22" Height="22">
                        <Path Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <Rectangle Height="1" Width="18" Fill="#242B38" Margin="0,0,0,4"/>

                <!-- Telemetry Pods Container (FlowDirection=LTR so % is cleanly positioned) -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                    <!-- RAM Vertical Pod -->
                    <Border Style="{StaticResource ToolbarPodStyle}" Width="28" Height="30" Padding="1,2" Margin="0,0,0,3" CornerRadius="6" ToolTip="استهلاك الذاكرة (RAM)">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="BarRamIconV" Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M12,4 A8,8 0 1,1 4,12 A8,8 0 0,1 12,4 Z" Fill="{StaticResource TealHealth}" Width="8.5" Height="8.5" Stretch="Uniform" Margin="0,0,0,1"/>
                            <TextBlock x:Name="BarRamTextV" Text="42%" Foreground="{StaticResource TealHealth}" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- CPU Vertical Pod -->
                    <Border Style="{StaticResource ToolbarPodStyle}" Width="28" Height="30" Padding="1,2" Margin="0,0,0,3" CornerRadius="6" ToolTip="استهلاك المعالج (CPU)">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="BarCpuIconV" Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M9,17 L7,17 L7,10 L9,10 L9,17 Z" Fill="{StaticResource TealHealth}" Width="8.5" Height="8.5" Stretch="Uniform" Margin="0,0,0,1"/>
                            <TextBlock x:Name="BarCpuTextV" Text="12%" Foreground="{StaticResource TealHealth}" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- NET Vertical Speed -->
                    <Border Style="{StaticResource ToolbarPodStyle}" Width="28" Height="26" Padding="1,1" Margin="0,0,0,4" CornerRadius="6" ToolTip="حركة نقل الشبكة">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="↓" Foreground="{StaticResource TealHealth}" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="BarNetSpeedV" Text="0K" Foreground="{StaticResource TealHealth}" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Rectangle Height="1" Width="18" Fill="#242B38" Margin="0,0,0,4"/>

                <!-- Turbo Boost Button -->
                <Button x:Name="BtnToolbarBoostV" Style="{StaticResource ToolbarBoostBtn}" Width="22" Height="22" Margin="0,0,0,4" Click="BtnToolbarBoost_Click" ToolTip="{DynamicResource ToolbarTooltipBoost}">
                    <Path x:Name="ToolbarBoostIconV" Data="M11,21 L13,13 L19,13 L8,2 L9,10 L3,10 Z" Fill="#FFFFFF" Width="9" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Button>

                <!-- Open Dashboard Button -->
                <Button Style="{StaticResource ToolbarIconBtn}" Width="20" Height="20" Margin="0,0,0,3" Click="BtnOpenDashboard_Click" ToolTip="{DynamicResource ToolbarTooltipOpenDashboard}">
                    <Path Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z" Fill="{StaticResource PrimaryAccent}" Width="8" Height="8" Stretch="Uniform"/>
                </Button>

                <!-- Auto-Hide / Pin Toggle -->
                <Button Style="{StaticResource ToolbarIconBtn}" Width="20" Height="20" Margin="0,0,0,3" Click="BtnToolbarPin_Click" ToolTip="{DynamicResource ToolbarTooltipPin}">
                    <Path x:Name="ToolbarPinIconV" Data="M16,12 L16,4 L17,4 L17,2 L7,2 L7,4 L8,4 L8,12 L6,14 L6,16 L11,16 L11,22 L13,22 L13,16 L18,16 L18,14 L16,12 Z" Fill="{StaticResource PrimaryAccent}" Width="8" Height="8" Stretch="Uniform"/>
                </Button>

                <!-- Close / Minimize -->
                <Button Style="{StaticResource ToolbarIconBtn}" Width="20" Height="20" Click="BtnToolbarClose_Click" ToolTip="{DynamicResource ToolbarTooltipHide}">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" SnapsToDevicePixels="True" Width="7" Height="7" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- 3. TOAST NOTIFICATION BANNER (Dark Theme Glass Obsidian with Shadow) -->
        <Border x:Name="ToastBanner"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Background="#F5141722"
                BorderBrush="{StaticResource TealHealth}"
                BorderThickness="1.2"
                CornerRadius="8"
                Padding="16,9"
                FlowDirection="RightToLeft">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="ToastIcon" Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M10,17 L5,12 L6.41,10.59 L10,14.17 L17.59,6.58 L19,8 L10,17 Z" Fill="{StaticResource TealHealth}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Text="تمت العملية بنجاح." Foreground="{StaticResource TealHealth}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
