                                                    <Path Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M9,17 L7,17 L7,10 L9,10 L9,17 Z" Fill="{StaticResource PrimaryAccent}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource ToolTaskMgr}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- 2. إدارة الأقراص -->
                                            <Button Style="{StaticResource ToolTileBtn}" Margin="4,0,0,6" Tag="diskmgmt" Click="LaunchTool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M20,13 L4,13 C3.45,13 3,13.45 3,14 L3,18 C3,18.55 3.45,19 4,19 L20,19 C20.55,19 21,18.55 21,18 L21,14 C21,13.45 20.55,13 20,13 Z" Fill="{StaticResource TealHealth}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
