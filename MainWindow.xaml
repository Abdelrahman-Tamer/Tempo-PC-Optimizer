                                                        <TextBlock Text="{Binding RamFormatted}" Foreground="{StaticResource PrimaryAccent}" FontSize="11" FontFamily="Consolas, monospace" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Storage Drives & TRIM -->
                                <Border Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource TxtStorageDrivesTitle}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
