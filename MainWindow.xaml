<Window x:Class="Tempo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tempo Diagnostic"
        Width="440" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="Segoe UI Variable Display, IBM Plex Sans, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- SLIM MODERN DARK SCROLLBAR (يثري الثيم الداكن ويلغي اللون الأبيض الافتراضي) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" Background="#2E3440" CornerRadius="3" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#0066FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="true">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#44DDC1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tempo Precision Instrumental Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#10131A"/>
        <SolidColorBrush x:Key="SurfaceLow" Color="#161922"/>
        <SolidColorBrush x:Key="SurfaceContainer" Color="#1D2027"/>
        <SolidColorBrush x:Key="SurfaceHigh" Color="#272A31"/>
        <SolidColorBrush x:Key="SurfaceHighest" Color="#32353C"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#2D343F"/>
        <SolidColorBrush x:Key="BorderLight" Color="#424656"/>

        <SolidColorBrush x:Key="PrimaryCobalt" Color="#0066FF"/>
        <SolidColorBrush x:Key="PrimaryCobaltHover" Color="#0054D6"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#B3C5FF"/>
        <SolidColorBrush x:Key="TealHealth" Color="#44DDC1"/>
        <SolidColorBrush x:Key="AmberWarn" Color="#FFB77D"/>
        <SolidColorBrush x:Key="RedAlert" Color="#FFB4AB"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#E0E2EC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#C2C6D8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8C90A1"/>

        <!-- Window Control Buttons (─, ✕) -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#272A31"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Rail Button Style -->
        <Style x:Key="NavRailButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222631"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UNIFIED STENCIL BUTTON STYLE (إسطمبة موحدة بمقاس ثابت ومحكم) -->
        <Style x:Key="ActionBtnStencil" TargetType="Button">
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#181B24"/>
            <Setter Property="Foreground" Value="#B3C5FF"/>
            <Setter Property="BorderBrush" Value="#2D343F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0066FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0066FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WARNING ACTION BUTTON STENCIL (للأزرار ذات شروط الأمان والتأكيد) -->
        <Style x:Key="ActionBtnWarningStencil" TargetType="Button">
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#1A1812"/>
            <Setter Property="Foreground" Value="#FFB77D"/>
            <Setter Property="BorderBrush" Value="#66FFB77D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFB77D"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFB77D"/>
                                <Setter Property="Foreground" Value="#10131A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Hero Button Style (Prominent with Blue Glow) -->
        <Style x:Key="PrimaryHeroBtn" TargetType="Button">
            <Setter Property="Background" Value="#0066FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#0066FF" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A75FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FULL-WIDTH TOOL TILE BUTTON (بلاطات أدوات كاملة العرض متناسقة) -->
        <Style x:Key="ToolTileBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#161922"/>
            <Setter Property="Foreground" Value="#E0E2EC"/>
            <Setter Property="BorderBrush" Value="#2D343F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222631"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0066FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TOOLBAR INTERACTIVE POD STYLE -->
        <Style x:Key="ToolbarPodStyle" TargetType="Border">
            <Setter Property="Background" Value="#171B25"/>
            <Setter Property="BorderBrush" Value="#2A3040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222838"/>
                    <Setter Property="BorderBrush" Value="#0066FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TOOLBAR TURBO BOOST ICON BUTTON (COMPACT CIRCLE) -->
        <Style x:Key="ToolbarBoostBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="16" BorderThickness="1" BorderBrush="#800066FF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0066FF" Offset="0"/>
                                    <GradientStop Color="#0047BA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1A75FF" Offset="0"/>
                                            <GradientStop Color="#005CE6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00C4FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TOOLBAR ICON BUTTON -->
        <Style x:Key="ToolbarIconBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Background" Value="#171B25"/>
            <Setter Property="BorderBrush" Value="#2A3040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252C3D"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0066FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Startup App Item Template (Shared for Security and Regular Groups) -->
        <DataTemplate x:Key="StartupAppItemTemplate">
            <Border Background="#161922" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,5" ToolTip="{Binding TooltipText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Real Extracted App Icon -->
                    <Border Grid.Column="0" Width="28" Height="28" Background="#11141C" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Grid>
                            <Path Data="M4,6 L20,6 L20,18 L4,18 Z M6,8 L18,8 L18,16 L6,16 Z" Fill="{StaticResource TextMuted}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding IconSource}" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <!-- Column 1: Info (Name, Security Badge, Scope) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding SecurityBadgeVisibility}" Background="#25FFB77D" BorderBrush="#FFB77D" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Security service - Recommended to keep enabled">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,1 L3,5 L3,11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 L21,5 L12,1 Z" Fill="{StaticResource AmberWarn}" Width="8" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                    <TextBlock Text="🛡️" FontSize="8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="4.5" Height="4.5" Fill="{StaticResource TealHealth}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LocationFriendly}" Foreground="{StaticResource TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Column 2: Action Button -->
                    <Button Grid.Column="2" Width="74" Height="26" Style="{StaticResource ActionBtnStencil}" Content="{Binding ActionText}" Click="BtnDisableStartupApp_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 1. MAIN DASHBOARD VIEW -->
        <Border x:Name="MainDashboardView"
                Background="{StaticResource BgDark}"
                BorderBrush="{StaticResource BorderMuted}"
                BorderThickness="1"
                CornerRadius="10"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER BAR (RTL: Logo & Title on Right, Window Controls on Left) -->
                <Border x:Name="DashboardHeader" Grid.Row="0" Background="{StaticResource SurfaceLow}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title & Logo (Right side in RTL) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6" Background="#1D2027" BorderBrush="#2D343F" BorderThickness="1" Margin="0,0,8,0">
                                <Image x:Name="ImgHeaderLogo" RenderOptions.BitmapScalingMode="HighQuality" Margin="2"/>
                            </Border>
                            <TextBlock Text="Tempo Diagnostic" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Background="#1D2027" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock Text="PRO" Foreground="{StaticResource PrimaryAccent}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                            </Border>
                        </StackPanel>

                        <!-- Window Controls (Left side in RTL) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Discord-Style Download / Update Button -->
                            <Button x:Name="BtnUpdateBadge" Style="{StaticResource WindowControlBtn}" Width="Auto" Height="26" Padding="6,2" Margin="0,0,6,0" Click="BtnUpdateBadge_Click" Visibility="Collapsed" ToolTip="{DynamicResource BtnTooltipUpdate}">
                                <Border Background="#10B981" CornerRadius="13" Padding="7,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M4,15 L12,23 L20,15 M12,3 L12,22" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="TxtUpdateBadgeText" Text="{DynamicResource BtnUpdateBadgeText}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button x:Name="BtnQuickToolbar" Style="{StaticResource WindowControlBtn}" Click="BtnLaunchToolbar_Click" ToolTip="{DynamicResource BtnTooltipToolbar}">
                                <Path Data="M3,5 L21,5 L21,9 L3,9 Z M3,11 L21,11 L21,13 L3,13 Z" Fill="{StaticResource TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnMinimize" Style="{StaticResource WindowControlBtn}" Click="BtnMinimize_Click" ToolTip="{DynamicResource BtnTooltipMinimize}">
                                <Path Data="M0,0 L10,0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                            </Button>
                            <Button x:Name="BtnCloseApp" Style="{StaticResource WindowCloseBtn}" Click="BtnCloseApp_Click" ToolTip="{DynamicResource BtnTooltipClose}">
                                <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BODY: Navigation Rail (Column 0) + Content Stage (Column 1) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- NAVIGATION RAIL (Column 0: Left in LTR, Right in RTL) -->
                    <Border x:Name="BorderNavRail" Grid.Column="0" Background="{StaticResource SurfaceLow}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,6,0,0">
                                <!-- Overview Tab (نظرة) -->
                                <Button x:Name="BtnNavOverview" Style="{StaticResource NavRailButton}" Click="TabNavOverview_Click" ToolTip="{DynamicResource NavTooltipOverview}">
                                    <Grid Width="56" Height="54">
                                        <Rectangle x:Name="IndOverview" Width="3" Height="24" Fill="{StaticResource PrimaryCobalt}" HorizontalAlignment="Right" RadiusX="1.5" RadiusY="1.5" Visibility="Visible"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="IconNavOverview" Data="M12,4 A8,8 0 0,0 4,12 C4,14.2 4.9,16.2 6.3,17.7 L12,12 L17.7,17.7 C19.1,16.2 20,14.2 20,12 A8,8 0 0,0 12,4 Z M12,10 A2,2 0 1,1 12,14 A2,2 0 0,1 12,10 Z" Fill="{StaticResource PrimaryAccent}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtNavOverview" Text="{DynamicResource NavOverview}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccent}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Optimize Tab (تحسين) -->
                                <Button x:Name="BtnNavOptimize" Style="{StaticResource NavRailButton}" Click="TabNavOptimize_Click" ToolTip="{DynamicResource NavTooltipOptimize}">
                                    <Grid Width="56" Height="54">
                                        <Rectangle x:Name="IndOptimize" Width="3" Height="24" Fill="{StaticResource PrimaryCobalt}" HorizontalAlignment="Right" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="IconNavOptimize" Data="M11,21 L13,13 L19,13 L8,2 L9,10 L3,10 Z" Fill="{StaticResource TextSecondary}" Width="16" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtNavOptimize" Text="{DynamicResource NavOptimize}" FontSize="10" FontWeight="Normal" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Diagnostic Tab (فحص) -->
                                <Button x:Name="BtnNavDiagnostic" Style="{StaticResource NavRailButton}" Click="TabNavDiagnostic_Click" ToolTip="{DynamicResource NavTooltipDiagnostic}">
                                    <Grid Width="56" Height="54">
                                        <Rectangle x:Name="IndDiagnostic" Width="3" Height="24" Fill="{StaticResource PrimaryCobalt}" HorizontalAlignment="Right" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="IconNavDiagnostic" Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M9,17 L7,17 L7,10 L9,10 L9,17 Z M13,17 L11,17 L11,7 L13,7 L13,17 Z M17,17 L15,17 L15,13 L17,13 L17,17 Z" Fill="{StaticResource TextSecondary}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtNavDiagnostic" Text="{DynamicResource NavDiagnostic}" FontSize="10" FontWeight="Normal" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>

